# Copy to .env and fill in your keys. Never commit .env.

# Phase 1 — Free (Required)
COINGECKO_API_KEY=   # Optional; CoinPaprika + CoinCap fallback when rate-limited
FRED_API_KEY=

# CoinMarketCap (optional third fallback)
# When CoinGecko and CoinPaprika both fail: listings, global market cap, batch prices.
# Free tier: 10k calls/month, 30 req/min. Get key at https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=

# Phase 2 — Free Tier (Required)
ALPHA_VANTAGE_API_KEY=
CRYPTOQUANT_API_KEY=
COINGLASS_API_KEY=   # Optional; multi-venue funding (aggregated) for veto worst-case

# Gmail / SMTP (alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_PRIMARY_EMAIL=   # Critical alerts + daily reports; defaults to first ALERT_EMAIL_TO

# XRPL Ledger tab (optional) — public r-address to track
XRPL_ACCOUNT=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Risk
ACCOUNT_SIZE=20000
MAX_RISK_PCT=2.0

# Coinbase Advanced Trade (optional)
# Use exchange API keys with minimum permissions: read + trade only, no withdrawal.
# Rotate API keys on a schedule (e.g. monthly), independent of any AI tooling.
# COINBASE_API_KEY=
# COINBASE_API_SECRET=
